# Build context is the repo root (both Dockerfiles). Everything an image needs is copied
# explicitly; this keeps host artifacts, secrets and the mobile app out of the context.
.git
**/node_modules
**/dist
**/.expo
mobile/*
!mobile/package.json
audit
infra
*.md
.env
.env.*
**/.env
**/.env.*
!.env.example
**/config/local*.json
**/*.test.ts
