{
  "expo": {
    "name": "Platyko",
    "slug": "platyko",
    "sdkVersion": "54.0.0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": [
      "com.idoyahav.platyko",
      "com.googleusercontent.apps.858033290834-bhhndi5aqeqtj9r4t0fd3u5vs4aq9snd"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080930"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.idoyahav.platyko",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.idoyahav.platyko",
      "adaptiveIcon": {
        "backgroundColor": "#0C0C31",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Platyko uses your photo library only to let you choose a profile picture.",
          "cameraPermission": "Platyko uses the camera only to take a new profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "practice-reminders"
        }
      ]
    ]
  }
}
