model User {
  id                     String            @id @default(cuid())
  email                  String            @unique
  username               String            @unique
  hashedPassword         String?
  googleId               String?           @unique
  appleSub               String?           @unique
  avatarUrl              String?
  tokenVersion           Int               @default(0)
  emailVerified          Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  lastActiveAt           DateTime?
  activeExperienceLevel  ExperienceLevel?
  puzzleXpSolveCounts    Json                  @default("{}")

  progressRows      UserProgress[]
  refreshTokens     RefreshToken[]
  emailVerification EmailVerification?
  passwordReset     PasswordReset?
  duelSessionsP1  DuelSession[] @relation("Player1Sessions")
  duelSessionsP2  DuelSession[] @relation("Player2Sessions")
  wonSessions     DuelSession[] @relation("WinnerSessions")
}
