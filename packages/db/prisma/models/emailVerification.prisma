// One pending email-verification code per user. Only the bcrypt hash of the
// 6-digit code is stored; the row is deleted once the email is verified.
model EmailVerification {
  userId     String   @id
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
