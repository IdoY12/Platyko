# Local Docker Compose only. Copy to .env (gitignored). Never commit or reuse in production.
JWT_ACCESS_SECRET=local-dev-only-jwt-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=local-dev-only-jwt-refresh-secret-min-32-chars!
CORS_ORIGIN=http://localhost:8081
IO_CORS_ORIGIN=http://localhost:8081

# --- Transactional email (Resend) ---
# Sender is fixed in code: "Platyko <noreply@platyko.com>" (domain verified in Resend).
# Resend dashboard -> API Keys. Leave empty locally to skip sending (failures are logged only).
RESEND_API_KEY=
# Resend dashboard -> Webhooks -> your endpoint -> Signing secret (starts with whsec_).
RESEND_WEBHOOK_SECRET=
