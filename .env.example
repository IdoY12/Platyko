# ─────────────────────────────────────────────────────────────────────────────
# LOCAL (docker-compose.yml): copy to .env. Dev-only placeholders; never reuse them anywhere else.
# ─────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=local-dev-only-jwt-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=local-dev-only-jwt-refresh-secret-min-32-chars!
CORS_ORIGIN=http://localhost:8081
IO_CORS_ORIGIN=http://localhost:8081
# Leave empty locally to skip sending (failures are logged only).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION (docker-compose.prod.yml): copy to .env.production (gitignored) and fill EVERY value.
# The backend refuses to boot (validateBackendSecurity) on placeholders, short secrets, identical
# secrets, http:// origins, wildcard CORS or the dev postgres password. Generate secrets with:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
# Postgres superuser password for the `platyko` role (compose builds DATABASE_URL from it).
#POSTGRES_PASSWORD=<openssl rand -hex 24>
# HS256 signing secrets, 64 hex chars each, MUST differ from each other.
#JWT_ACCESS_SECRET=<openssl rand -hex 32>
#JWT_REFRESH_SECRET=<openssl rand -hex 32>
# Explicit https origins allowed by the REST API and by Socket.IO (comma-separated; no "*").
# Native apps send no Origin header, so these only matter for browser callers.
#CORS_ORIGIN=https://platyko.com
#IO_CORS_ORIGIN=https://platyko.com
# Resend dashboard -> API Keys (starts with re_) and Webhooks -> endpoint
# https://api.platyko.com/api/webhooks/resend -> Signing secret (starts with whsec_).
#RESEND_API_KEY=re_...
#RESEND_WEBHOOK_SECRET=whsec_...
# Avatar bucket. Leave the AWS_* keys empty to use an instance/IAM role instead.
#S3_BUCKET=platyko-avatars-prod
#AWS_REGION=eu-central-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# Google Sign-In OAuth client ids (public; backend/config/default.json ships the current ones).
#GOOGLE_WEB_CLIENT_ID=
#GOOGLE_IOS_CLIENT_ID=
# Let's Encrypt account email for Caddy's automatic certificates.
#CADDY_ACME_EMAIL=you@example.com
