# Local Docker Compose only. Copy to .env (gitignored). Never commit or reuse in production.
JWT_ACCESS_SECRET=local-dev-only-jwt-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=local-dev-only-jwt-refresh-secret-min-32-chars!
CORS_ORIGIN=http://localhost:8081
IO_CORS_ORIGIN=http://localhost:8081

# --- Email verification (AWS SES) ---
# Sender for registration OTP emails. Domain identity platyko.com is DKIM-verified in SES.
SES_FROM_EMAIL=Platyko <noreply@platyko.com>
# SES region — independent of AWS_REGION (which S3 uses), because our SES identities
# are verified in us-east-1 only. Defaults to us-east-1 when unset.
SES_REGION=us-east-1
# Optional: custom SES endpoint (e.g. LocalStack). Leave empty/unset for real AWS SES.
# SES_ENDPOINT=
# SES reuses the standard AWS credential env vars (also mapped to S3 config):
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# NOTE: while SES is in sandbox mode it only delivers to verified identities
# (idoyahav15@gmail.com) — register with that address to test end-to-end.
