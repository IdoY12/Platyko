# Copy to backend/.env (gitignored). Every variable the backend reads is listed here;
# they map onto backend/config/*.json via config/custom-environment-variables.json.

# node-config environment file to load (default | compose | docker | production)
NODE_CONFIG_ENV=
# Express production switches (stricter register rate limit)
NODE_ENV=development
# Config "env" label (development | production)
APP_ENV=development

# HTTP listen port / host
PORT=4000
HOST=0.0.0.0
# Max JSON request body size accepted by express.json
APP_BODY_PARSER_JSON_LIMIT=1mb
# Comma-separated allowed CORS origins ("*" for local dev only)
CORS_ORIGIN=*

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platyko?schema=public

# HS256 JWT signing secrets (min 32 chars in production, never placeholders)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google Sign-In OAuth client IDs (web + iOS) and Apple Sign-In bundle id
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_BUNDLE_ID=com.idoyahav.platyko

# Avatar storage (S3). AWS_ENDPOINT points at LocalStack locally; unset it in production.
S3_BUCKET=platyko-avatars
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Transactional email (Resend). Sender is fixed in code: "Platyko <noreply@platyko.com>".
# Resend dashboard -> API Keys
RESEND_API_KEY=
# Resend dashboard -> Webhooks -> endpoint /api/webhooks/resend -> Signing secret (whsec_...)
RESEND_WEBHOOK_SECRET=
