# Copy to backend/.env (gitignored). Every variable the backend reads is listed here;
# they map onto backend/config/*.json via config/custom-environment-variables.json.

# node-config environment file to load (default | compose | docker | production)
NODE_CONFIG_ENV=
# Express production switches (stricter register rate limit)
NODE_ENV=development
# Config "env" label (development | production)
APP_ENV=development

# HTTP listen port / host
PORT=4000
HOST=0.0.0.0
# Max JSON request body size accepted by express.json
APP_BODY_PARSER_JSON_LIMIT=1mb
# Comma-separated allowed CORS origins ("*" for local dev only)
CORS_ORIGIN=*

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platyko?schema=public

# HS256 JWT signing secrets (min 32 chars in production, never placeholders)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google Sign-In OAuth client IDs (web + iOS) and Apple Sign-In bundle id
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_BUNDLE_ID=com.idoyahav.platyko
# Sign in with Apple token revocation on account deletion (App Store requirement). Optional: when
# any is empty, sign-in works and revocation is skipped. Apple Developer -> Keys -> a key with
# "Sign in with Apple"; paste the .p8 contents with \n for line breaks. The encryption key is 32
# random bytes in base64 (`openssl rand -base64 32`) and protects the stored Apple refresh token.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_TOKEN_ENCRYPTION_KEY=

# GitHub sign-in and linking (PRD 14.3), off by default. Create an OAuth app (permissions are asked
# per request: read:user and user:email only) with the callback com.idoyahav.platyko://oauth/github.
# The secret stays here; the app never sees it.
GITHUB_SIGN_IN_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# "Explain my mistake" (PRD 15.9, owner decision D6), off by default. Any OpenAI-compatible chat
# endpoint works; the secondary is tried when the primary fails. Without these the app shows the
# pre-written explanations and hints.
# Primary, Cloudflare Workers AI (free plan): https://api.cloudflare.com/client/v4/accounts/<account id>/ai/v1
# Secondary, Groq (free plan): https://api.groq.com/openai/v1
AI_EXPLAIN_ENABLED=false
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
AI_SECONDARY_BASE_URL=
AI_SECONDARY_API_KEY=
AI_SECONDARY_MODEL=

# Avatar storage (S3). AWS_ENDPOINT points at LocalStack locally; unset it in production.
S3_BUCKET=platyko-avatars
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Transactional email (Resend). Sender is fixed in code: "Platyko <noreply@platyko.com>".
# Resend dashboard -> API Keys
RESEND_API_KEY=
# Resend dashboard -> Webhooks -> endpoint /api/webhooks/resend -> Signing secret (whsec_...)
RESEND_WEBHOOK_SECRET=
